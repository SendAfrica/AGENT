# SendAfrica API Credentials
SENDAFRICA_API_BASE=https://api.sendafrica.online/v1
SENDAFRICA_API_KEY=SA-your-sendafrica-api-key-here

# MailAfrica API Credentials (Phase 2 Multi-Channel)
MAILAFRICA_API_BASE=https://api.mailafrica.online
MAILAFRICA_API_KEY=MA-your-mailafrica-api-key-here

# Ngamia LLM Gateway Credentials
NGAMIA_BASE_URL=https://api.ngamia.cc/v1
NGAMIA_API_KEY=ngm_your_ngamia_api_key_here
NGAMIA_MODEL=openai/gpt-4o-mini

# Agent & Webhook Configuration
AGENT_WEBHOOK_SECRET=your_webhook_hmac_secret_here
AGENT_DB_PATH=agent.db
AGENT_DEFAULT_MODE=off
AGENT_ALLOWED_ORIGINS=https://app.sendafrica.online,https://app.mailafrica.online
AGENT_ALLOWED_HOSTS=api.sendafrica.online,localhost,127.0.0.1
AGENT_REQUEST_TIMEOUT_SECONDS=45
AGENT_CHAT_MAX_LOOPS=4
AGENT_CHAT_HISTORY_LIMIT=30
AGENT_TOOL_TIMEOUT_SECONDS=25
AGENT_RATE_LIMIT_PER_MINUTE=60
AGENT_REQUIRE_CALLER_AUTH=true
AGENT_MCP_AUTH_TOKEN=generate-a-long-random-token-for-remote-sse
AGENT_HOST=0.0.0.0
AGENT_PORT=8000
